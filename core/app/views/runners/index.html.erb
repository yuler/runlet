<div class="flex justify-between items-center mb-8">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
    <div class="text-sm text-muted mt-1"><%= t(".subtitle") %></div>
  </div>
  <%= link_to t(".back"), root_path, class: "btn btn-secondary btn-sm" %>
</div>

<section class="p-6 border rounded-xl bg-surface shadow-sm mb-8">
  <div class="flex justify-between items-center gap-4 mb-4">
    <div>
      <h2 class="text-lg font-bold"><%= t(".setup_title") %></h2>
      <div class="text-sm text-muted mt-1"><%= t(".setup_subtitle") %></div>
    </div>
  </div>

  <div class="flex flex-col gap-3">
    <div>
      <div class="text-xs text-muted uppercase mb-2"><%= t(".setup_step") %></div>
      <pre class="p-4 border rounded-md bg-zinc-50 font-mono text-sm overflow-x-auto"><code><%= @runner_setup_command %></code></pre>
    </div>

    <div>
      <div class="text-xs text-muted uppercase mb-2"><%= t(".start_step") %></div>
      <pre class="p-4 border rounded-md bg-zinc-50 font-mono text-sm overflow-x-auto"><code>runlet-runner</code></pre>
    </div>
  </div>
</section>

<div class="flex flex-col gap-4">
  <% if @runners.any? %>
    <%= render partial: "runner", collection: @runners %>
  <% else %>
    <div class="p-8 border rounded-xl bg-surface text-center text-muted">
      <%= t(".empty") %>
    </div>
  <% end %>
</div>

<section class="mt-8">
  <div class="flex justify-between items-center mb-4">
    <h2 class="text-lg font-bold"><%= t(".recent_runs") %></h2>
  </div>

  <div class="flex flex-col gap-3">
    <% if @recent_runs.any? %>
      <% @recent_runs.each do |run| %>
        <div class="p-4 border rounded-xl bg-surface">
          <div class="flex justify-between gap-3">
            <div class="font-mono text-sm truncate"><%= run.command %></div>
            <span class="bg-zinc-100 px-2 py-0.5 rounded-md text-xs font-mono uppercase"><%= run.status %></span>
          </div>
          <div class="text-xs text-muted mt-2">
            <%= run.runner.name %>
            <% if run.exit_code.present? %>
              • <%= t(".exit_code", code: run.exit_code) %>
            <% end %>
            <% if run.finished_at.present? %>
              • <%= time_ago_in_words(run.finished_at) %> ago
            <% end %>
          </div>
          <% if run.events.any? %>
            <pre class="mt-3 p-3 border rounded-md bg-zinc-50 font-mono text-xs overflow-x-auto"><code><%= run.events.order(:sequence).last(6).map { |event| "[#{event.stream || event.level}] #{event.message}" }.join("\n") %></code></pre>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="p-6 border rounded-xl bg-surface text-center text-muted">
        <%= t(".no_runs") %>
      </div>
    <% end %>
  </div>
</section>
